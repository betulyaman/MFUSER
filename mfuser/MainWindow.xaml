<Window x:Class="mfuser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mfuser"
        mc:Ignorable="d"
        Title="Kernel Shield Manager" Height="600" Width="1000"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1177BB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/> <!--take all the remaining available space-->
            <ColumnDefinition Width="5"/> <!--so the user can resize the divider-->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Upper-left: Operations list -->
            <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46"
                    BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Submitted Operations"
                               Style="{StaticResource HeaderStyle}"/>

                    <ListView Grid.Row="1" x:Name="OperationsList"
                              Background="#1E1E1E" Foreground="White"
                              BorderBrush="#3F3F46" BorderThickness="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="40"
                                    DisplayMemberBinding="{Binding Index}"/>
                                <GridViewColumn Header="Path" Width="300"
                                    DisplayMemberBinding="{Binding Path}"/>
                                <GridViewColumn Header="Operation" Width="100"
                                    DisplayMemberBinding="{Binding Operation}"/>
                                <GridViewColumn Header="Status" Width="80"
                                    DisplayMemberBinding="{Binding Status}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- Bottom-left: Input area -->
            <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="New Operation"
                               Style="{StaticResource HeaderStyle}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Path"
                               Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Operation"
                               Style="{StaticResource LabelStyle}" Margin="6,0,0,4"/>

                    <TextBox Grid.Row="2" Grid.Column="0" x:Name="PathTextBox"
                             KeyDown="PathTextBox_KeyDown"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="OperationComboBox"
                              Margin="6,0,0,0">
                        <ComboBoxItem Content="shield" IsSelected="True"/>
                        <ComboBoxItem Content="unshield"/>
                    </ComboBox>
                    <Button Grid.Row="2" Grid.Column="2" x:Name="SubmitButton"
                            Content="Submit" Margin="6,0,0,0"
                            Click="SubmitButton_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="#3F3F46"/>

        <!-- RIGHT SIDE: Logs -->
        <Border Grid.Column="2" Background="#252526" BorderBrush="#3F3F46"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock Text="Kernel Logs" Style="{StaticResource HeaderStyle}"
                               DockPanel.Dock="Left"/>
                    <Button x:Name="ClearLogsButton" Content="Clear"
                            DockPanel.Dock="Right" Click="ClearLogsButton_Click"
                            Background="#5A1D1D"/>
                </DockPanel>

                <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#3F3F46"
                        BorderThickness="1">
                    <ScrollViewer x:Name="LogScrollViewer"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"
                                               Foreground="{Binding Color}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Padding="6,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <CheckBox Grid.Row="2" x:Name="AutoScrollCheckBox"
                          Content="Auto-scroll" Foreground="#CCCCCC"
                          IsChecked="True" Margin="0,6,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
