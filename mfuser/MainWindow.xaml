<Window x:Class="mfuser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mfuser"
        mc:Ignorable="d"
        Title="Kernel Shield Manager" Height="600" Width="1000"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1177BB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Smaller, neutral button used in the input row + filter bar -->
        <Style x:Key="MutedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505054"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle-like filter button. The "active" look is set in code-behind. -->
        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource MutedButton}">
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/> <!--take all the remaining available space-->
            <ColumnDefinition Width="5"/> <!--so the user can resize the divider-->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Upper-left: Operations list -->
            <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46"
                    BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock Text="Submitted Operations"
                                   Style="{StaticResource HeaderStyle}"
                                   DockPanel.Dock="Left"/>
                        <Button x:Name="ClearOperationsButton" Content="Clear"
                                Style="{StaticResource MutedButton}"
                                DockPanel.Dock="Right"
                                Click="ClearOperationsButton_Click"/>
                        <Button x:Name="ViewProtectedFilesButton" Content="Protected files..."
                                Style="{StaticResource MutedButton}"
                                DockPanel.Dock="Right" Margin="0,0,6,0"
                                ToolTip="Show every file currently under minifilter protection (folders expanded)"
                                Click="ViewProtectedFilesButton_Click"/>
                        <Button x:Name="RefreshOperationsButton" Content="Refresh"
                                Style="{StaticResource MutedButton}"
                                DockPanel.Dock="Right" Margin="0,0,6,0"
                                Click="RefreshOperationsButton_Click"/>
                        <!-- Hint so users know rows are interactive -->
                        <TextBlock Text="(double-click a row to toggle)"
                                   Foreground="#888888" FontStyle="Italic"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="10,0,0,6"
                                   DockPanel.Dock="Left"/>
                    </DockPanel>

                    <ListView Grid.Row="1" x:Name="OperationsList"
                              Background="#1E1E1E" Foreground="White"
                              BorderBrush="#3F3F46" BorderThickness="1"
                              MouseDoubleClick="OperationsList_MouseDoubleClick">
                        <!-- Hand cursor on every row for affordance -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="40"
                                    DisplayMemberBinding="{Binding Index}"/>
                                <GridViewColumn Header="Path" Width="280"
                                    DisplayMemberBinding="{Binding Path}"/>
                                <GridViewColumn Header="Operation" Width="90"
                                    DisplayMemberBinding="{Binding Operation}"/>
                                <GridViewColumn Header="Status" Width="90"
                                    DisplayMemberBinding="{Binding Status}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- Bottom-left: Input area -->
            <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Selection always shields. To unshield, double-click
                         the path in a log line on the right pane. -->
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Shield a file or folder"
                               Style="{StaticResource HeaderStyle}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Path"
                               Style="{StaticResource LabelStyle}"/>

                    <TextBox Grid.Row="2" Grid.Column="0" x:Name="PathTextBox"
                             KeyDown="PathTextBox_KeyDown"/>
                    <Button  Grid.Row="2" Grid.Column="1" x:Name="BrowseFileButton"
                             Content="File..." Margin="6,0,0,0"
                             ToolTip="Pick a file"
                             Style="{StaticResource MutedButton}"
                             Click="BrowseFileButton_Click"/>
                    <Button  Grid.Row="2" Grid.Column="2" x:Name="BrowseFolderButton"
                             Content="Folder..." Margin="4,0,0,0"
                             ToolTip="Pick a folder"
                             Style="{StaticResource MutedButton}"
                             Click="BrowseFolderButton_Click"/>
                    <Button Grid.Row="2" Grid.Column="3" x:Name="SubmitButton"
                            Content="Shield" Margin="6,0,0,0"
                            Click="SubmitButton_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="#3F3F46"/>

        <!-- RIGHT SIDE: Logs -->
        <Border Grid.Column="2" Background="#252526" BorderBrush="#3F3F46"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock Text="Kernel Logs" Style="{StaticResource HeaderStyle}"
                               DockPanel.Dock="Left"/>
                    <Button x:Name="ClearLogsButton" Content="Clear"
                            DockPanel.Dock="Right" Click="ClearLogsButton_Click"
                            Background="#5A1D1D"/>
                </DockPanel>

                <!-- Filter bar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Show:" Foreground="#CCCCCC"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="FilterAllButton" Content="All"
                            Style="{StaticResource FilterButton}"
                            Click="FilterButton_Click" Tag="All"/>
                    <Button x:Name="FilterWarningsButton" Content="Warnings"
                            Style="{StaticResource FilterButton}"
                            Click="FilterButton_Click" Tag="Warnings"/>
                    <Button x:Name="FilterErrorsButton" Content="Errors"
                            Style="{StaticResource FilterButton}"
                            Click="FilterButton_Click" Tag="Errors"/>
                    <TextBlock x:Name="LogCountText" Foreground="#888888"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#3F3F46"
                        BorderThickness="1">
                    <!-- A single read-only RichTextBox so the user can drag-select
                         across multiple log lines, Ctrl+A to select all, Ctrl+C to
                         copy, and right-click to copy. Each log entry is one
                         Paragraph with a colored Run. -->
                    <RichTextBox x:Name="LogList"
                                 Background="#1E1E1E"
                                 Foreground="LightGray"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"
                                 IsDocumentEnabled="False"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 SelectionBrush="#264F78">
                        <RichTextBox.Document>
                            <FlowDocument PagePadding="6,2,6,2"/>
                        </RichTextBox.Document>
                    </RichTextBox>
                </Border>

                <CheckBox Grid.Row="3" x:Name="AutoScrollCheckBox"
                          Content="Auto-scroll" Foreground="#CCCCCC"
                          IsChecked="True" Margin="0,6,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
